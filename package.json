{
  "name": "@mgz-dev/alac",
  "version": "0.1.1",
  "type": "module",
  "description": "Apple Lossless (ALAC) decoder in pure Rust, compiled to WebAssembly.",
  "license": "MIT",
  "author": {
    "name": "Marco Gomez",
    "email": "marco@mgz.dev",
    "url": "https://mgz.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcogomez/alac.git"
  },
  "keywords": [
    "alac",
    "apple-lossless",
    "audio",
    "codec",
    "decoder",
    "wasm",
    "webassembly",
    "rust",
    "m4a",
    "mp4"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "pnpm run build-wasm && rimraf dist tsconfig.tsbuildinfo && tsup && tsc --emitDeclarationOnly",
    "build-wasm": "node scripts/build-wasm.mjs",
    "check-wasm": "node scripts/build-wasm.mjs --check",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint-fix": "eslint src --fix",
    "lint-rust": "cargo fmt --manifest-path crate/Cargo.toml --check && cargo clippy --manifest-path crate/Cargo.toml --all-targets -- -D warnings",
    "test": "vitest run",
    "test-rust": "cargo test --manifest-path crate/Cargo.toml",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@mgz-dev/codestyle": "^1.0.0",
    "@types/node": "^25.0.3",
    "binaryen": "^132.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.28.2"
}
